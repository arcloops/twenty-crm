{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "22.14.0",
      "ios": {
        "image": "latest"
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "extends": "base",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_TWENTY_API_URL": "https://crm-api.arcloops.io",
        "EXPO_PUBLIC_TWENTY_ORIGIN": "https://crm.arcloops.io",
        "EXPO_PUBLIC_PRIVACY_POLICY_URL": "https://www.arcloops.ai/privacy",
        "EXPO_PUBLIC_EAS_PROJECT_ID": "5821493b-0911-4b52-9f15-b8e241e40f8f"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6820139033"
      },
      "android": {}
    }
  }
}
