# Arcloops CRM — small-team (8–10 users) production template
# Copy to packages/twenty-docker/.env or paste into Railway service variables.
#
# Topology: 1× Node (API + queues), 1× Postgres, 1× Redis, S3.
# Do NOT run a separate worker when RUN_WORKERS_IN_SERVER=true.
#
# RUN_WORKERS_IN_SERVER only works on images built from this repo
# (packages/twenty-docker/twenty/Dockerfile). Upstream twentycrm/twenty ignores it.
# Env-only: set on the Railway service, not via Admin DB config UI.

TAG=local
SERVER_URL=https://crm-api.arcloops.io
FRONTEND_URL=https://crm.arcloops.io

# --- Memory (Railway: set service memory limit just above peak RSS) ---
NODE_OPTIONS=--max-old-space-size=512
RUN_WORKERS_IN_SERVER=true
WORKER_EXCLUDED_QUEUES=ai-queue,ai-stream-queue,campaign-queue,campaign-send-queue,campaign-engagement-queue,billing-queue

# Suggested Railway memory limits (adjust after measuring RSS):
#   server: 768 MB
#   postgres: 512 MB
#   redis: 192 MB
#   worker: REMOVE this service

# --- Secrets (openssl rand -base64 32) ---
ENCRYPTION_KEY=
APP_SECRET=

# --- Database / Redis (Railway plugins or compose) ---
# PG_DATABASE_URL=postgres://...
# REDIS_URL=redis://...

# --- Storage ---
STORAGE_TYPE=s3
STORAGE_S3_REGION=
STORAGE_S3_NAME=
STORAGE_S3_ENDPOINT=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=

# --- Google-only auth + sync ---
AUTH_GOOGLE_ENABLED=true
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_GOOGLE_CALLBACK_URL=https://crm-api.arcloops.io/auth/google/redirect
AUTH_GOOGLE_APIS_CALLBACK_URL=https://crm-api.arcloops.io/auth/google-apis/get-access-token
MESSAGING_PROVIDER_GMAIL_ENABLED=true
CALENDAR_PROVIDER_GOOGLE_ENABLED=true

# Password kept as emergency fallback while Google is rolled out
AUTH_PASSWORD_ENABLED=true
AUTH_MICROSOFT_ENABLED=false
MESSAGING_PROVIDER_MICROSOFT_ENABLED=false
CALENDAR_PROVIDER_MICROSOFT_ENABLED=false
IS_IMAP_SMTP_CALDAV_ENABLED=false

# --- Keep off (cost / unused) ---
IS_BILLING_ENABLED=false
IS_MULTIWORKSPACE_ENABLED=false
ANALYTICS_ENABLED=false
IS_ONBOARDING_AI_CHAT_ENABLED=false
IS_COMPANY_ENRICHMENT_ENABLED=false
