# n8n Railway service only — not Twenty core.
# Paste into the n8n service variables. Do not commit real secrets.
# TEAMS_* and TWENTY_CRM_API_KEY must never be added to twenty-server / front / worker.

# --- n8n host ---
N8N_HOST=n8n.arcloops.io
N8N_PORT=5678
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n.arcloops.io/
N8N_ENCRYPTION_KEY=
N8N_SECURE_COOKIE=true
GENERIC_TIMEZONE=Asia/Dhaka

# --- Postgres (database name must be n8n, not Twenty's default) ---
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=${{Postgres.PGHOST}}
DB_POSTGRESDB_PORT=${{Postgres.PGPORT}}
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=${{Postgres.PGUSER}}
DB_POSTGRESDB_PASSWORD=${{Postgres.PGPASSWORD}}
DB_POSTGRESDB_SSL_ENABLED=true

# --- Twenty callback (server origin, no /graphql suffix) ---
# GraphQL is POST $TWENTY_CRM_API_URL/graphql (not /api/graphql).
# REST is $TWENTY_CRM_API_URL/rest/people, /rest/opportunities, …
TWENTY_CRM_API_URL=https://<twenty-server-public-host>
TWENTY_CRM_API_KEY=

# Opportunity.stage values used by Stripe / Tally workflows.
# After Settings rename (see docs/workspace-setup.md) keep these.
# Until then, Twenty defaults are NEW (inbound) and CUSTOMER (won):
#   TWENTY_INBOUND_STAGE=NEW
#   TWENTY_WON_STAGE=CUSTOMER
TWENTY_INBOUND_STAGE=WARM_CONTACT
TWENTY_WON_STAGE=WON

# --- Teams Incoming Webhooks (n8n or SDK app — not Twenty core) ---
TEAMS_BD_WEBHOOK_URL=
TEAMS_ENGINEERING_WEBHOOK_URL=
TEAMS_GENERAL_WEBHOOK_URL=

# --- Downstream (placeholders) ---
BREVO_API_KEY=
BREVO_CRM_LIST_ID=
STRIPE_WEBHOOK_SECRET=
CERTIFICATE_PORTAL_API_URL=https://certs.arcloops.io/api
CERTIFICATE_PORTAL_API_KEY=
