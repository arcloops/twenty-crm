# Phase 5 — Auth, email, files (UAT)
# Fill these in the Railway dashboard (uat shared vars, or twenty-server +
# twenty-worker). Never commit real secrets.
#
# Front host (already set as FRONTEND_URL):
#   https://crm-staging.arcloops.io
#
# API host: replace <twenty-server-public-host> with the twenty-server public
# URL (or crm-api-staging.arcloops.io if you add that CNAME). Same placeholder
# as SERVER_URL in uat.env.example.
#
# Names match packages/twenty-server/.env.example and config-variables.ts.
# Do not use MS_TENANT_ID, GMAIL_CONNECTED_ACCOUNT_*, SMTP_HOST, FRONT_BASE_URL,
# AWS_ACCESS_KEY_ID, or LLM_CHAT_MODEL.

# ——— Google sign-in ———
# Google Cloud → Credentials → OAuth client (Web). Authorized redirect URI:
#   https://<twenty-server-public-host>/auth/google/redirect
AUTH_GOOGLE_ENABLED=true
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_GOOGLE_CALLBACK_URL=https://<twenty-server-public-host>/auth/google/redirect

# ——— Gmail / Google APIs (same AUTH_GOOGLE_CLIENT_* as sign-in) ———
# This server has no second Google client-id variable. Add this redirect URI
# to the same OAuth client whose ID/secret you pasted above:
#   https://<twenty-server-public-host>/auth/google-apis/get-access-token
MESSAGING_PROVIDER_GMAIL_ENABLED=
AUTH_GOOGLE_APIS_CALLBACK_URL=https://<twenty-server-public-host>/auth/google-apis/get-access-token

# Optional (enable with Gmail if you want Calendar sync)
# CALENDAR_PROVIDER_GOOGLE_ENABLED=

# ——— Microsoft sign-in + Graph APIs ———
# Azure → App registration → Authentication → Web redirect URIs:
#   https://<twenty-server-public-host>/auth/microsoft/redirect
#   https://<twenty-server-public-host>/auth/microsoft-apis/get-access-token
# There is no MS_TENANT_ID in this server config.
AUTH_MICROSOFT_ENABLED=
AUTH_MICROSOFT_CLIENT_ID=
AUTH_MICROSOFT_CLIENT_SECRET=
AUTH_MICROSOFT_CALLBACK_URL=https://<twenty-server-public-host>/auth/microsoft/redirect
AUTH_MICROSOFT_APIS_CALLBACK_URL=https://<twenty-server-public-host>/auth/microsoft-apis/get-access-token

# Optional
# MESSAGING_PROVIDER_MICROSOFT_ENABLED=
# CALENDAR_PROVIDER_MICROSOFT_ENABLED=

# ——— Brevo SMTP ———
# Copy host / port / login / SMTP key from the Brevo SMTP settings page.
# Do not invent SMTP_HOST — the names are EMAIL_SMTP_*.
EMAIL_DRIVER=smtp
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=

# ——— Cloudflare R2 (S3-compatible) ———
# Overrides STORAGE_TYPE=local from uat.env.example once you are ready.
# Do not use AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY.
STORAGE_TYPE=s3
STORAGE_S3_REGION=auto
STORAGE_S3_NAME=
STORAGE_S3_ENDPOINT=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=

# ——— Anthropic (optional) ———
# There is no LLM_CHAT_MODEL. Pin models with AI_MODELS_DEFAULT_* if needed.
ANTHROPIC_API_KEY=
# AI_MODELS_DEFAULT_FAST=
# AI_MODELS_DEFAULT_SMART=
# AI_MODELS_DEFAULT_RECOMMENDED=
# AI_MODELS_DEFAULT_DISABLED=
