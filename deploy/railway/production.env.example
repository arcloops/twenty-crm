# Production shared variables for Railway environment "production".
# Paste into Railway → Project → production → Shared Variables (or each service).
# Do not commit real secrets.
#
# Generate a NEW APP_SECRET — do not reuse UAT or local.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Create a NEW Postgres and NEW Redis in the production environment.
# Do not point PG_DATABASE_URL / REDIS_URL at UAT (or local) databases.

NODE_ENV=production
APP_SECRET=
FRONTEND_URL=https://crm.arcloops.io
SERVER_URL=https://<twenty-server-public-host>
PG_DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}
SIGN_IN_PREFILLED=false
STORAGE_TYPE=local
EMAIL_DRIVER=LOGGER
LOG_LEVELS=error,warn

# Front service only (build-time)
# REACT_APP_SERVER_BASE_URL=https://<twenty-server-public-host>

# Nixpacks / Railway Node (Twenty is ^24.5.0 — do not use Node 18/20/26)
NIXPACKS_NODE_VERSION=24

# Twenty listens on NODE_PORT. The service start command maps
# NODE_PORT=${PORT:-3000}. Set NODE_PORT only if you override the start command.

# ——— Phase 5 (commented). Uncomment after filling prod OAuth / SMTP / R2.
# Callbacks go to the *production* API host, not crm-staging.
# Do not reuse UAT client secrets, SMTP keys, or R2 tokens.
#
# AUTH_GOOGLE_ENABLED=true
# AUTH_GOOGLE_CLIENT_ID=
# AUTH_GOOGLE_CLIENT_SECRET=
# AUTH_GOOGLE_CALLBACK_URL=https://<twenty-server-public-host>/auth/google/redirect
# MESSAGING_PROVIDER_GMAIL_ENABLED=
# AUTH_GOOGLE_APIS_CALLBACK_URL=https://<twenty-server-public-host>/auth/google-apis/get-access-token
# AUTH_MICROSOFT_ENABLED=
# AUTH_MICROSOFT_CLIENT_ID=
# AUTH_MICROSOFT_CLIENT_SECRET=
# AUTH_MICROSOFT_CALLBACK_URL=https://<twenty-server-public-host>/auth/microsoft/redirect
# AUTH_MICROSOFT_APIS_CALLBACK_URL=https://<twenty-server-public-host>/auth/microsoft-apis/get-access-token
# EMAIL_DRIVER=smtp
# EMAIL_FROM_ADDRESS=
# EMAIL_FROM_NAME=
# EMAIL_SMTP_HOST=
# EMAIL_SMTP_PORT=
# EMAIL_SMTP_USER=
# EMAIL_SMTP_PASSWORD=
# STORAGE_TYPE=s3
# STORAGE_S3_REGION=auto
# STORAGE_S3_NAME=
# STORAGE_S3_ENDPOINT=
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
# ANTHROPIC_API_KEY=
